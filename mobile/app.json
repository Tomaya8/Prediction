{
  "expo": {
    "name": "Predich",
    "slug": "predictspinz",
    "owner": "tomaya",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "predich",
    "splash": {
      "image": "./splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F5F7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.predich.app",
      "infoPlist": {
        "NSPredictionMarketUsageDescription": "Predich allows you to trade virtual credits on real-world events.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "4"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./icon.png",
        "backgroundColor": "#F5F5F7"
      },
      "package": "com.predich.app",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F5F7",
          "image": "./splash.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "aaeb5b23-afa5-4df8-b082-5ab05b0074d3"
      },
      "router": {
        "origin": false
      }
    }
  }
}
