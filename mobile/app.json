{
  "expo": {
    "name": "PredictSpinz",
    "slug": "predictspinz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "predictspinz",
    "splash": {
      "image": "./splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F0EDE8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.predictspinz.app",
      "infoPlist": {
        "NSPredictionMarketUsageDescription": "PredictSpinz allows you to trade virtual credits on real-world events.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./icon.png",
        "backgroundColor": "#F0EDE8"
      },
      "package": "com.predictspinz.app",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F0EDE8",
          "image": "./splash.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "predictspinz-app"
      }
    }
  }
}
