# PredictSpinz Mobile Environment Variables
# Copy this to .env and fill in your actual Firebase values

# Firebase Project ID (use prediction-app-2026)
FIREBASE_PROJECT_ID=prediction-app-2026

# Backend API URL (when deployed)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# For Firebase, download google-services.json from Firebase Console
# https://console.firebase.google.com/project/prediction-app-2026/settings/general/android
#
# Steps to configure Firebase:
# 1. Go to Firebase Console: https://console.firebase.google.com/
# 2. Select project: prediction-app-2026
# 3. Add Android app with package name: com.predictspinz.app
# 4. Download google-services.json and place in mobile/ directory
# 5. Enable Firestore in Firebase Console > Firestore Database
